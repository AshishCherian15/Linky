generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  publicLinks  PublicLink[]

  @@map("users")
}

model PublicLink {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  shortCode   String   @unique
  longUrl     String
  customAlias Boolean  @default(false)
  title       String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  clicks      Click[]

  @@index([userId])
  @@index([shortCode])
  @@map("public_links")
}

model Click {
  id         String     @id @default(uuid())
  linkId     String
  link       PublicLink @relation(fields: [linkId], references: [id])
  clickedAt  DateTime   @default(now())
  referrer   String?
  deviceType String?
  country    String?
  ipHash     String?

  @@index([linkId])
  @@map("clicks")
}
